# serine-hydrolase demo theozyme
# --- constraint 1 ---
CST::BEGIN
  # Ser nucleophile -> substrate carbonyl carbon (tetrahedral TS)
  TEMPLATE::   ATOM_MAP: 1 atom_name: OG CB CA ,
  TEMPLATE::   ATOM_MAP: 1 residue3: SER
  TEMPLATE::   ATOM_MAP: 2 atom_name: C1 O1 O2 ,
  TEMPLATE::   ATOM_MAP: 2 residue3: LIG
  CONSTRAINT:: distanceAB:     2.80   0.20   100.0    0.0 1
  CONSTRAINT:: angle_A:   105.00   5.00    50.0  360.0 1
  CONSTRAINT:: angle_B:   109.50   5.00    50.0  360.0 1
  CONSTRAINT:: torsion_A:   180.00  15.00    25.0  360.0 1
CST::END

# --- constraint 2 ---
CST::BEGIN
  # His general base abstracts Ser-OG proton
  TEMPLATE::   ATOM_MAP: 1 atom_name: NE2 CE1 ND1 ,
  TEMPLATE::   ATOM_MAP: 1 residue3: HIS
  TEMPLATE::   ATOM_MAP: 2 atom_name: OG CB CA ,
  TEMPLATE::   ATOM_MAP: 2 residue3: SER
  CONSTRAINT:: distanceAB:     2.70   0.20   100.0    0.0 1
  CONSTRAINT:: angle_A:   120.00   8.00    30.0  360.0 1
CST::END
